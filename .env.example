# =====================================================================
# Client Management System - environment configuration
# Copy this file to .env and adjust for your deployment.
# =====================================================================

# Application
APP_NAME=Client Management System
APP_ENV=development          # development | production | testing
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./cms.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://cms:cms@localhost:5432/cms
# MySQL example:
# DATABASE_URL=mysql+aiomysql://cms:cms@localhost:3306/cms

# Security
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# Multi-tenancy
# Set to "true" to require an organization on every client/user; "false" for single-tenant.
MULTI_TENANT=true

# Document storage
# local = filesystem (default); s3 = S3-compatible
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
# S3 settings (only used when STORAGE_BACKEND=s3):
# STORAGE_S3_BUCKET=cms-uploads
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT_URL=      # e.g. http://localhost:9000 for MinIO
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Seed data
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123